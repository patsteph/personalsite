# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin (Server-side)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY=your_private_key

# External APIs
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Application Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VERSION=1.0.0

# Deployment Configuration
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# Monitoring & Analytics
SNYK_TOKEN=your_snyk_token

# Environment-specific
NODE_ENV=development
BASE_PATH=

# Staging Environment Variables
STAGING_FIREBASE_API_KEY=your_staging_firebase_api_key
STAGING_FIREBASE_AUTH_DOMAIN=your_staging_project_id.firebaseapp.com
STAGING_FIREBASE_PROJECT_ID=your_staging_project_id
STAGING_FIREBASE_STORAGE_BUCKET=your_staging_project_id.appspot.com
STAGING_FIREBASE_MESSAGING_SENDER_ID=your_staging_messaging_sender_id
STAGING_FIREBASE_APP_ID=your_staging_firebase_app_id
STAGING_GOOGLE_BOOKS_API_KEY=your_staging_google_books_api_key